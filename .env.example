# Optional: dedicated token for password recovery in the login page.
PANEL_RECOVERY_TOKEN=change-this-to-a-long-random-secret

# Optional: Railway API token can also be used by the password-recovery flow.
# RAILWAY_API_TOKEN=

# Optional: override the upstream source used by the in-panel updater.
UPDATE_SOURCE_URL=https://raw.githubusercontent.com/panel-zeus/Z-E-U-S/refs/heads/main/zeus.obfuscated.js

# Optional diagnostic logging.
DEBUG=0
